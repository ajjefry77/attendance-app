# رشتهٔ اتصال PostgreSQL (Neon). از Vercel → Storage → Neon یا داشبورد Neon بگیرید.
# برای اتصال serverless از آدرس pooled استفاده کنید و sslmode=require را نگه دارید.
# اگر Integration نئون متغیرها را با پیشوند ساخته باشد (مثل ATTENDANCE_DATABASE_URL)،
# همان نام پیشوند‌دار هم بدون تغییر کد پذیرفته می‌شود.
# ⚠️ مقدار واقعی را هرگز در این فایلِ ردیابی‌شده نگذارید؛ فقط در .env که در gitignore است.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# کلید امضای نشست‌ها؛ یک رشتهٔ تصادفی و طولانی (حداقل ۱۶ کاراکتر)
AUTH_SECRET=

# حساب استاد؛ در اولین درخواست به‌صورت خودکار در جدول professors ساخته/به‌روز می‌شود.
PROFESSOR_USERNAME=arad
PROFESSOR_PASSWORD=
PROFESSOR_NAME=آراد جعفری
